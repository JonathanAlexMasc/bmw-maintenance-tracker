{
    "name": "car-maintenance-tracker-web",
    "version": "0.1.0",
    "description": "Next.js dashboard for car maintenance tracker",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "prisma generate --schema prisma/schema.prisma && next build",
        "start": "next start",
        "lint": "next lint",
        "test": "jest",
        "db:generate": "prisma generate --schema prisma/schema.prisma",
        "db:push": "prisma db push --schema prisma/schema.prisma",
        "db:seed": "tsx prisma/seed.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.8.2",
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "axios": "^1.4.0",
        "date-fns": "^2.30.0",
        "lucide-react": "^0.263.0",
        "next": "^13.4.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.1.0",
        "zustand": "^4.3.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^14.0.0",
        "@types/jest": "^29.5.0",
        "eslint": "^8.40.0",
        "eslint-config-next": "^13.4.0",
        "jest": "^29.5.0",
        "prisma": "^6.8.2",
        "ts-jest": "^29.1.0",
        "tsx": "^4.22.3"
    }
}
